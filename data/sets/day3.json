            {
              "key": "B",
              "text": "downloaded"
            },
            {
              "key": "C",
              "text": "downloading"
            },
            {
              "key": "D",
              "text": "downloads"
            }
          ],
          "answer": "B",
          "explain": "can be downloaded 是被动语态。",
          "zh": {
            "stem": "申请表可以从人力资源门户网站下载。",
