  "title": "Day 1",
  "focus": "",
  "listening": null,
  "phrases": [
    "by Friday",
    "within three days",
    "responsible for doing",
    "once approved",
    "later than expected"
  ],
  "reviews": [
    "1 by + 时间点 = 最迟不晚于；6 within + 时间长度 = 在这段时间内。",
    "2 more 后接形容词 reliable；8 worked 需要副词 efficiently 修饰。",
    "3 because 后接完整句；13 due to 后接名词 repairs。",
    "4 responsible for doing；11 should 后接动词原形；12 later than expected 是固定省略结构。",
    "7 once + 完整句 = 一经/一旦；14 until further notice = 另行通知前。",
    "15 be encouraged to do = 被鼓励做；16 只有 B 能承接维修结束后的安排。",
    "17 may 后接动词原形 cause；18-20 先看 purpose / who / conflict，再回邮件定位。",
    "21-24 两篇材料共同定位；equipment cases 对应需要接应，beforehand 对应会前存放。"
  ],
  "source_pdf": "TOEIC_720_Day1_双面练习_v3.pdf",
  "recommended_minutes": 27,
  "note": "原创 TOEIC-style 仿真题，不是 ETS 官方真题。",
  "groups": [
    {
      "id": "day1-p5",
      "part": 5,
      "title": "Part 5 | Incomplete Sentences 句子填空",
      "minutes": 10,
      "passages": [],
      "questions": [
        {
          "id": "day1-q1",
          "n": 1,
          "part": 5,
          "kind": "question",
          "bonus": false,
          "rev": 0,
          "stem": "Applicants must submit all required documents ___ Friday.",
          "options": [
            {
              "key": "A",
              "text": "from"
            },
            {
              "key": "B",
              "text": "by"
            },
            {
              "key": "C",
              "text": "among"
            },
            {
              "key": "D",
              "text": "during"
            }
          ],
          "answer": "B",
          "explain": "by + 时间点 = 最迟不晚于",
          "zh": {
            "stem": "申请人必须在周五之前提交所有必需的文件。",
            "options": {
              "A": "介词：从……起（起点），from Monday = 从周一开始；只说开始，不说截止",
              "B": "介词：最迟在……之前（截止时间点），by Friday = 周五前必须交 ✓",
              "C": "介词：在……之中（三者以上），among the applicants = 在申请人当中；后面接一群人/物，不接时间",
              "D": "介词：在……期间，during the meeting = 开会期间；后面接一段时间或事件，不接“周五”这种截止点"
            },
            "vocab": [
              {
                "word": "applicant",
                "zh": "申请人（apply 申请 + -ant 人）"
              },
              {
                "word": "submit",
                "zh": "提交、上交"
              },
              {
                "word": "required",
                "zh": "必需的、被要求的"
              },
              {
                "word": "document",
                "zh": "文件、材料"
              }
            ]
          }
        },
        {
          "id": "day1-q2",
          "n": 2,
          "part": 5,
          "kind": "question",
          "bonus": false,
          "rev": 0,
          "stem": "The new laboratory instrument is more ___ than the previous model.",
          "options": [
            {
              "key": "A",
              "text": "rely"
            },
            {
              "key": "B",
              "text": "reliably"
            },
            {
              "key": "C",
              "text": "reliable"
            },
            {
              "key": "D",
              "text": "reliance"
            }
          ],
          "answer": "C",
          "explain": "more 后接形容词 reliable",
          "zh": {
            "stem": "这台新的实验室仪器比上一款型号更可靠。",
            "options": {
              "A": "动词：依赖、依靠，rely on sb. = 依靠某人；more 后面不能直接接动词",
              "B": "副词：可靠地，works reliably = 运转可靠；副词不能放在 is 后面当表语",
              "C": "形容词：可靠的、靠得住的，a reliable supplier = 靠谱的供应商；more + 形容词 = 比较级 ✓",
              "D": "名词：依赖，reliance on imports = 对进口的依赖；“更依赖比上一款”说不通"
            },
            "vocab": [
              {
                "word": "laboratory",
                "zh": "实验室（常缩写为 lab）"
              },
              {
                "word": "instrument",
                "zh": "仪器、器械（这里不是“乐器”）"
              },
              {
                "word": "previous",
                "zh": "之前的、上一个的"
              },
              {
                "word": "model",
                "zh": "型号（这里不是“模特”）"
              }
            ]
          }
        },
        {
          "id": "day1-q3",
          "n": 3,
          "part": 5,
          "kind": "question",
          "bonus": false,
          "rev": 0,
          "stem": "The seminar was postponed ___ the keynote speaker was unable to attend.",
          "options": [
            {
              "key": "A",
              "text": "because"
            },
            {
              "key": "B",
              "text": "despite"
            },
            {
              "key": "C",
              "text": "during"
            },
            {
              "key": "D",
              "text": "unless"
            }
          ],
          "answer": "A",
          "explain": "because 后接完整句",
          "zh": {
            "stem": "因为主讲嘉宾无法出席，研讨会被推迟了。",
            "options": {
              "A": "连词：因为，后面接完整句子（有主语有动词）✓",
              "B": "介词：尽管，despite the rain = 尽管下雨；后面只能接名词，不能接句子",
              "C": "介词：在……期间，during the seminar = 研讨会期间；接名词，不接句子",
              "D": "连词：除非，unless you call = 除非你打电话；能接句子，但“除非讲者来不了就推迟”逻辑反了"
            },
            "vocab": [
              {
                "word": "seminar",
                "zh": "研讨会、讲座"
              },
              {
                "word": "postpone",
                "zh": "推迟、延期（= put off）"
              },
              {
                "word": "keynote speaker",
                "zh": "主题演讲人、主讲嘉宾"
              },
              {
                "word": "be unable to",
                "zh": "无法、不能（able 的反义）"
              },
              {
                "word": "attend",
                "zh": "出席、参加"
              }
            ]
          }
        },
        {
          "id": "day1-q4",
          "n": 4,
          "part": 5,
          "kind": "question",
          "bonus": false,
          "rev": 0,
          "stem": "Ms. Patel is responsible for ___ the equipment before delivery.",
          "options": [
            {
              "key": "A",
              "text": "inspect"
            },
            {
              "key": "B",
              "text": "inspected"
            },
            {
              "key": "C",
              "text": "inspection"
            },
            {
              "key": "D",
              "text": "inspecting"
            }
          ],
          "answer": "D",
          "explain": "responsible for doing",
          "zh": {
            "stem": "Patel 女士负责在发货前检查设备。",
            "options": {
              "A": "动词原形：检查、检验；介词 for 后面不能直接接动词原形",
              "B": "过去式/过去分词：检查过（的）；介词后面不能接",
              "C": "名词：检查（这件事），a safety inspection = 安全检查；语法上能接在 for 后，但名词后面不能再直接带宾语 the equipment",
              "D": "动名词：检查，be responsible for doing = 负责做某事，后面还能带宾语 ✓"
            },
            "vocab": [
              {
                "word": "be responsible for",
                "zh": "负责……、对……负责"
              },
              {
                "word": "equipment",
                "zh": "设备（不可数，不加 s）"
              },
              {
                "word": "delivery",
                "zh": "交货、送货（动词 deliver）"
              }
            ]
          }
        },
        {
          "id": "day1-q5",
          "n": 5,
          "part": 5,
          "kind": "question",
          "bonus": false,
          "rev": 0,
          "stem": "Dr. Han ___ the revised manuscript before the meeting began.",
          "options": [
            {
              "key": "A",
              "text": "reviews"
            },
            {
              "key": "B",
              "text": "had reviewed"
            },
            {
              "key": "C",
              "text": "will review"
            },
            {
              "key": "D",
              "text": "is reviewing"
            }
          ],
          "answer": "B",
          "explain": "before + 过去时从句（began），更早完成的动作用过去完成时 had reviewed。",
          "zh": {
            "stem": "会议开始之前，韩博士已经审阅过修改后的稿件了。",
            "options": {
              "A": "一般现在时：审阅；后面 began 是过去，时态对不上",
              "B": "过去完成时：（在过去某个时间点之前）已经审阅过，“过去的过去”，before + 过去时从句就用它 ✓",
              "C": "将来时：将要审阅；和过去的 began 冲突",
              "D": "现在进行时：正在审阅；时态对不上"
            },
            "vocab": [
              {
                "word": "review",
                "zh": "审阅、审查（动词；名词是“评审/评论”）"
              },
              {
                "word": "revised",
                "zh": "修改过的、修订的（revise 修改）"
              },
              {
                "word": "manuscript",
                "zh": "稿件、手稿（投稿论文常叫 manuscript）"
              }
            ]
          }
        },
        {
          "id": "day1-q6",
          "n": 6,
          "part": 5,
          "kind": "question",
          "bonus": false,
          "rev": 0,
          "stem": "All expense reports must be submitted ___ three days after the trip.",
